# ==============================================================================
# AIVIQ-ZAP — Variáveis de Ambiente para Produção (Vercel / Railway / VPS)
# ==============================================================================

# 1. URL da Aplicação (produção oficial — única URL fixa do projeto)
NEXT_PUBLIC_APP_URL=https://aiviq-zap-web-tiscinovacoes-projects.vercel.app
ALLOW_DEMO_LOGIN=true

# 2. WhatsApp Evolution API (Railway)
EVOLUTION_API_URL=https://evolution-api-production-8ecf.up.railway.app
EVOLUTION_API_KEY=aiviq_zap_secret_2026
# Pool de proxies brasileiros: 1 IP/sessao dedicada por numero/instancia.
# JSON array em uma linha. Dois tipos de entrada:
#  (1) ESTATICO (ISP/dedicado) -- ideal. Uma entrada = um chip.
#  (2) TEMPLATE por instancia (residencial sticky): `{instance}` no username vira
#      o nome da instancia => cada chip ganha a SUA sessao sticky. Serve N chips.
#      Use a MAIOR duracao de sessao que o provedor permitir (o IP troca quando
#      a sessao expira e o WhatsApp pode derrubar: 401 conflict / device_removed).
# EVOLUTION_PROXY_REQUIRED=true => recusa conectar sem proxy dedicado (estrito).
# Sem essa flag, conecta mesmo assim e devolve `proxyWarning` na resposta.
# Nao defina PROXY_* no servico Evolution (Railway): valeria para todas as instancias.
# EVOLUTION_PROXY_POOL=[{"host":"ip1.exemplo.net","port":"3001","username":"user1","password":"senha1","protocol":"http"},{"host":"proxy.smartproxy.net","port":"3120","username":"smart-xxx_area-BR_state-MATOGROSSODOSUL_life-120_session-{instance}","password":"senha","protocol":"http"}]
# EVOLUTION_PROXY_REQUIRED=false
# Instancia padrao (a que o Inbox abre e o fallback de envio usa):
# EVOLUTION_INSTANCE=67992143047

# 3. Meta Cloud API Oficial & Webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=aiviq_webhook_secret_token_2026
WHATSAPP_APP_SECRET=aiviq_secret_key_2026
# Token compartilhado que autentica o ingress do webhook da Evolution API.
# Enviado por header (x-webhook-token) e, como fallback self-hosted, na query.
# Se ausente, cai em EVOLUTION_API_KEY. Comparação em tempo constante no receiver.
EVOLUTION_WEBHOOK_TOKEN=aiviq_evo_webhook_2026

# 4. Supabase (Opcional - caso conectado a um banco externo)
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=seu_anon_key
# SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key
